DATABASE_URL=sqlite:///./mivo.db
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Requests/minute pacing for the shared Gemini pacer; free tier is tight.
GEMINI_RPM=5
# Negotiation depth. Each round costs 1 buyer call + 1 call per competing merchant,
# so rounds trade directly against Gemini quota and demo wall-clock time.
NEGOTIATION_ROUNDS=2
NEGOTIATION_DEADLINE=600
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
SETTLEMENT_CONTRACT=
ONEINCH_API_KEY=
WORLD_APP_ID=
WORLD_ACTION=mivo-checkout
PAYMENT_ENABLED=false
SETTLEMENT_TOKEN=0x3600000000000000000000000000000000000000
SETTLEMENT_DECIMALS=6
QUOTE_SIGNER_FILE=.secrets/quote-signer.key
CONFIRMATIONS=2
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
WORLD_SANDBOX=true
WORLD_REQUIRED=false

# --- Vercel ---
# VERCEL / VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL are injected by Vercel. With VERCEL=1:
# APP_ORIGIN defaults to https://$VERCEL_PROJECT_PRODUCTION_URL, cookies are Secure, and
# negotiations are run by the client calling /negotiations/{id}/run (function limit 300s).
# Use a Postgres URL (postgres://... is accepted) and keep NEGOTIATION_DEADLINE under 300.

# Raspberry Pi image identification (POST /api/device/identify). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_API_KEY=
# Buyer account (sign up on the website first) that owns negotiations started with ?negotiate=true.
DEVICE_BUYER_EMAIL=
# How many demo dealers each device negotiation invites.
DEVICE_DEALERS=3
# Rounds per device negotiation; each round is ONE Gemini call for all dealers.
DEVICE_ROUNDS=2
